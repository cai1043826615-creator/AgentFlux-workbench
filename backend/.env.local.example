# 复制本文件为 .env.local 并填写真实值（.env.local 已被 gitignore，不会入库）
# 不配置时系统自动降级为内置模拟内容，流程仍可端到端跑通
# 变量名与 backend/src/config.ts 一致（DEEPSEEK_* 文本 / IMAGE_* 生图）

# --- 文本 LLM 渠道（OpenAI 兼容 /chat/completions） ---
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# --- 图像生成渠道（OpenAI 兼容 /images/generations） ---
IMAGE_BASE_URL=https://img-api.apinebula.ai/v1
IMAGE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
IMAGE_MODEL=gpt-image-2

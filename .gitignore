# 密钥与本地数据不入库
backend/.env.local
backend/data/
# 知识库本地配置（Vault 绝对路径与个性化关注域，不入库；见 openspec changes/knowledge-base）
backend/config/
*.db
*.db-wal
*.db-shm
node_modules/
dist/
.DS_Store

# 环境变量（保留 .env.example 模板可入库）
.env
.env.local
.env.*.local

# 密钥类文件（无论放在哪个目录，一律不入库）
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
secrets*
*credentials*
*credential.json
*service-account*.json
.ssh/

# 本地工具与日志
.agents/
.claude/
.pnpm-store/
debug.log

# Firecrawl 调研缓存（网页抓取产物，不入库）
.firecrawl/

# git 内部元数据备份目录（.git 快照，本不该入库；曾因 add -A 误入库过）
.git-backup-*
.git-tmp-*
.git-snapshot-*

# 编辑器/系统
.idea/
.vscode/
Thumbs.db

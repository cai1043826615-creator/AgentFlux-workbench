{
  "name": "multi-agent-ecom-workbench",
  "private": true,
  "version": "0.1.0",
  "description": "多 Agent 电商新品上架工作台 (OpenSpec: multi-agent-ecom-workbench)",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter ./frontend --filter ./backend dev",
    "dev:frontend": "pnpm --filter ./frontend dev",
    "dev:backend": "pnpm --filter ./backend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter ./backend db:generate",
    "db:migrate": "pnpm --filter ./backend db:migrate"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
